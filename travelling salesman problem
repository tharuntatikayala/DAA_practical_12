
#include <iostream>
#include <algorithm>
using namespace std;

#define INF 999999

int n;
int cost[10][10];
int dp[10][1024];

int tsp(int city, int mask) {

    // If all cities are visited, return to starting city
    if (mask == (1 << n) - 1) {
        return cost[city][0];
    }

    // If already calculated, return stored result
    if (dp[city][mask] != -1) {
        return dp[city][mask];
    }

    int ans = INF;

    // Visit unvisited cities
    for (int i = 0; i < n; i++) {

        if ((mask & (1 << i)) == 0) {

            int newCost = cost[city][i] +
                          tsp(i, mask | (1 << i));

            ans = min(ans, newCost);
        }
    }

    return dp[city][mask] = ans;
}

int main() {

    cout << "Enter number of cities: ";
    cin >> n;

    cout << "Enter cost matrix:\n";

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> cost[i][j];
        }
    }

    // Initialize DP array
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < (1 << n); j++) {
            dp[i][j] = -1;
        }
    }

    // Start from city 0
    int result = tsp(0, 1);

    cout << "Minimum travelling cost = " << result;

    return 0;
}
